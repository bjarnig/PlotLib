Square, whatever the window.

EXAMPLES::
code::
p = Platform.resourceDir +/+ "sounds/a11wlk01.wav";
PltRecurrence.fromSoundFile(p).front;
PltRecurrence.fromSoundFile(p, \mel, [\flux, \level]).front;
PltRecurrence.fromSoundFile(p, \mfcc, nil).front;

// any sequence of vectors: a random walk in three dimensions
(
var x = [0, 0, 0];
PltRecurrence({ x = x + ({ 0.2.rand2 } ! 3) } ! 150, nil, 150, "walk").front;
)
::
